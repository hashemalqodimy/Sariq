rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == "hashem714pro@gmail.com";
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Reports Collection
    match /phone_reports/{reportId} {
      // Anyone can read reports
      allow read: if true;
      
      // Creating a report (the client must stamp its own verified email as userEmail)
      allow create: if isAuthenticated() 
                    && request.resource.data.imei1 is string 
                    && request.resource.data.imei1.size() == 15 
                    && request.resource.data.modelName is string
                    && request.resource.data.district is string
                    && request.resource.data.userEmail == request.auth.token.email;

      // Updating a report (only owner or admin)
      allow update: if isAdmin() || (isAuthenticated() && request.auth.token.email == resource.data.userEmail);
      
      // Deleting a report (only owner or admin)
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.token.email == resource.data.userEmail);
    }

    // Urgent Alerts Collection
    match /urgent_alerts/{alertId} {
      // Anyone can read alerts
      allow read: if true;
      
      // Any signed-in user may broadcast an alert for a report they file;
      // only Admin can edit or remove alerts.
      allow create: if isAuthenticated()
                    && request.resource.data.title is string
                    && request.resource.data.message is string;
      allow update, delete: if isAdmin();
    }

    // Queue consumed by the FCM backend trigger (write-only for clients)
    match /fcm_broadcast_queue/{itemId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Device push tokens: each client only writes its own document
    match /fcm_device_tokens/{tokenId} {
      allow read: if isAdmin();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      // Users can read their own data, Admin can read all
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can update their own data, Admin can update all (e.g. banning)
      allow create, update: if isOwner(userId) || isAdmin();
      
      // Only Admin can delete users
      allow delete: if isAdmin();
    }
  }
}
